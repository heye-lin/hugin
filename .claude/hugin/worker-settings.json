{
  "ultracode": false,
  "enabledPlugins": {
    "oh-my-claudecode@omc": false,
    "superpowers@anthropic-plugin-directory": false,
    "context7@anthropic-plugin-directory": false,
    "claude-security@anthropic-plugin-directory": false,
    "frontend-design@anthropic-plugin-directory": false,
    "vectorlab-ui-ux-skills@anthropic-plugin-directory": false,
    "code-review-anthropics@anthropic-plugin-directory": false
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  },
  "permissions": {
    "deny": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git * --output=*)",
      "Bash(git * --output *)",
      "Bash(git -C* push *)",
      "Bash(git -C * push *)",
      "Bash(git reset --hard *)",
      "Bash(git -C* reset --hard *)",
      "Bash(git -C * reset --hard *)",
      "Bash(git clean *)",
      "Bash(git -C* clean *)",
      "Bash(git -C * clean *)",
      "Bash(rm -rf *)",
      "PowerShell(git push *)",
      "PowerShell(git push)",
      "PowerShell(git * --output=*)",
      "PowerShell(git * --output *)",
      "PowerShell(git -C* push *)",
      "PowerShell(git -C * push *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git -C* reset --hard *)",
      "PowerShell(git -C * reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git -C* clean *)",
      "PowerShell(git -C * clean *)",
      "PowerShell(Remove-Item -Recurse *)",
      "PowerShell(Remove-Item -r *)"
    ]
  }
}
