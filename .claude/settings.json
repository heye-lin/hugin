{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git worktree *)",
      "Bash(git rev-parse *)",
      "Bash(git -C * status *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * log *)",
      "Bash(git -C * rev-parse *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(node --test *)",
      "Bash(node --check *)",
      "Bash(node bin/hugin-cli.mjs *)",
      "Bash(python -m unittest *)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m unittest *)",
      "Bash(python3 -m pytest *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git worktree *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git -C * status *)",
      "PowerShell(git -C * diff *)",
      "PowerShell(git -C * log *)",
      "PowerShell(git -C * rev-parse *)",
      "PowerShell(node --test *)",
      "PowerShell(node --check *)",
      "PowerShell(node bin/hugin-cli.mjs *)",
      "PowerShell(python -m unittest *)",
      "PowerShell(python -m pytest *)",
      "PowerShell(python3 -m unittest *)",
      "PowerShell(python3 -m pytest *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force)",
      "Bash(git * --output=*)",
      "Bash(git -C* push *)",
      "Bash(git -C* reset --hard *)",
      "Bash(git -C * push *)",
      "Bash(git -C * reset --hard *)",
      "Bash(git -C * clean -f*)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(rm -rf *)",
      "PowerShell(git push *)",
      "PowerShell(git * --output=*)",
      "PowerShell(git -C* push *)",
      "PowerShell(git -C * push *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git -C * reset --hard *)",
      "PowerShell(Remove-Item -Recurse *)",
      "PowerShell(Remove-Item -r *)",
      "Bash(git push origin main *)",
      "Bash(git push origin master *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/task-created.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/task-completed.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
