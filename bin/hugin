#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

usage() {
  cat <<'EOF'
Hugin

Usage:
  hugin start                 Start the master Claude session in this repo
  hugin dashboard             Open the background-agent dashboard (claude agents)
  hugin console [--port N]    Serve the read-only web console on 127.0.0.1
  hugin ps [--all]            Print background sessions as JSON
  hugin attach <id|name>      Attach this terminal to a background session
  hugin logs <id|name>        Print recent output of a background session
  hugin stop <id|name>        Stop a background session
  hugin new-run [run-id]      Create .hugin/runs/<run-id> and set CURRENT_RUN
  hugin memory                Show the project memory index and recent lessons
  hugin remember <text>       Append a dated lesson to .hugin/memory/lessons.md
  hugin recall <query>        Search .hugin/memory and run evidence
  hugin status [--all]        Show current run and Hugin background sessions
  hugin doctor [--quick]      Check the environment (no mutating actions)
  hugin help                  Show this help
EOF
}

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "missing: $1" >&2
    return 1
  }
}

new_run() {
  local run="${1:-$(date +%Y%m%d-%H%M%S)}"
  local dir="$ROOT/.hugin/runs/$run"
  mkdir -p "$dir/tasks" "$dir/reviews" "$dir/logs"
  if [ -f "$dir/run.json" ]; then
    printf '%s\n' "$run" >"$ROOT/.hugin/CURRENT_RUN"
    echo "run already exists: $run (reused)" >&2
    echo "$run"
    return 0
  fi
  local base
  base="$(git rev-parse --short HEAD 2>/dev/null || echo none)"
  cat >"$dir/run.json" <<EOF
{"run":"$run","base":"$base","created_at":"$(date -Iseconds)","status":"active"}
EOF
  printf '%s\n' "$run" >"$ROOT/.hugin/CURRENT_RUN"
  echo "$run"
}

status() {
  local all=0
  [ "${1:-}" = "--all" ] && all=1
  local run=""
  [ -f "$ROOT/.hugin/CURRENT_RUN" ] && run="$(cat "$ROOT/.hugin/CURRENT_RUN")"
  echo "repo: $ROOT"
  if command -v wslpath >/dev/null 2>&1; then
    local winpath
    winpath="$(wslpath -w "$ROOT" 2>/dev/null || true)"
    [ -n "$winpath" ] && echo "win:  $winpath"
  fi
  echo "run:  ${run:-<none>}"

  local runjson="$ROOT/.hugin/runs/$run/run.json"
  if [ -n "$run" ] && [ -f "$runjson" ]; then
    if command -v jq >/dev/null 2>&1; then
      jq -r '"      \(.status // "unknown")  base=\(.base // "-")  created=\(.created_at // "-")"' "$runjson" 2>/dev/null || true
    else
      cat "$runjson"
    fi
  fi

  local board="$ROOT/.hugin/runs/$run/board.json"
  if [ -n "$run" ] && [ -f "$board" ] && command -v jq >/dev/null 2>&1; then
    jq -r 'if ((.tasks // []) | length) == 0 then "tasks: none"
      else "tasks: \(.tasks | length) total — " + ([.tasks[] | .status // "unknown"] | group_by(.) | map("\(.[0])=\(length)") | join(", "))
      end' "$board" 2>/dev/null || true
  fi
  echo

  if command -v claude >/dev/null 2>&1; then
    local label="active"
    [ "$all" -eq 1 ] && label="all"
    echo "background sessions ($label):"
    if command -v jq >/dev/null 2>&1; then
      local data rows hidden
      data="$(claude agents --json --all 2>/dev/null || true)"
      rows="$(printf '%s' "$data" | jq -r --argjson all "$all" '
        .[] | select(.name? // "" | startswith("hugin-"))
        | select($all == 1 or ((.state // .status // "") != "stopped"))
        | [.id // "-", .state // .status // "-", .name // "-", .waitingFor // "-"] | @tsv' 2>/dev/null \
        | awk -F '\t' '{ printf "  %-12s %-9s %-34s %s\n", $1, $2, $3, $4 }' || true)"
      if [ -n "$rows" ]; then
        printf '%s\n' "$rows"
      else
        echo "  (none)"
        if [ "$all" -eq 0 ]; then
          hidden="$(printf '%s' "$data" | jq -r '
            [.[] | select(.name? // "" | startswith("hugin-"))
             | select((.state // .status // "") == "stopped")] | length' 2>/dev/null || echo 0)"
          [ "${hidden:-0}" -gt 0 ] && echo "  $hidden stopped session(s) hidden — use 'ng status --all'"
        fi
      fi
    else
      claude agents --json --all 2>/dev/null || true
    fi
  fi
}

memory() {
  echo "== .hugin/memory/INDEX.md =="
  if [ -f .hugin/memory/INDEX.md ]; then
    sed -n '1,120p' .hugin/memory/INDEX.md
  else
    echo "(missing)"
  fi
  echo
  echo "== recent lessons =="
  grep -h '^- ' .hugin/memory/lessons.md 2>/dev/null | tail -20 || true
}

remember() {
  local text="$*"
  if [ -z "$text" ]; then
    echo "usage: hugin remember <text>" >&2
    return 1
  fi
  mkdir -p .hugin/memory
  printf -- '- %s: %s\n' "$(date +%F)" "$text" >>.hugin/memory/lessons.md
  echo "remembered: $text"
  echo "file: .hugin/memory/lessons.md"
}

recall() {
  local q="$*"
  if [ -z "$q" ]; then
    echo "usage: hugin recall <query>" >&2
    return 1
  fi
  grep -Rni --include='*.md' --include='*.json' -- "$q" .hugin/memory .hugin/runs 2>/dev/null | head -40 || true
}

doctor() {
  local quick=0
  [ "${1:-}" = "--quick" ] && quick=1
  local failures=0

  check() {
    local name="$1"
    shift
    if "$@" >/dev/null 2>&1; then
      printf 'PASS  %s\n' "$name"
    else
      printf 'FAIL  %s\n' "$name"
      failures=$((failures + 1))
    fi
  }

  check "running inside WSL2" grep -qi microsoft /proc/version
  check "claude on PATH" bash -lc 'command -v claude'
  check "claude version" claude --version
  check "node on PATH" bash -lc 'command -v node'
  check "git on PATH" bash -lc 'command -v git'
  check "inside a git repository" git rev-parse --is-inside-work-tree
  check "hooks: node --check lib" node --check .claude/hooks/lib.mjs
  check "hooks: node --check task-created" node --check .claude/hooks/task-created.mjs
  check "hooks: node --check task-completed" node --check .claude/hooks/task-completed.mjs
  check "hooks: node --check session-start" node --check .claude/hooks/session-start.mjs
  check "console: node --check server" node --check lib/console.mjs
  check "console: node --check cli" node --check bin/hugin-console.mjs
  check "console: web assets" test -f web/index.html -a -f web/app.css -a -f web/app.js
  check ".hugin/runs writable" test -w .hugin/runs
  check "claude agents JSON" bash -lc 'claude agents --json >/dev/null'
  check "git worktree" git worktree list

  if command -v curl >/dev/null 2>&1; then
    check "proxy 127.0.0.1:3425" curl -sf -m 3 http://127.0.0.1:3425
  else
    printf 'SKIP  proxy check (curl missing)\n'
  fi

  if [ "$quick" -eq 0 ]; then
    printf 'INFO  git status timing on /mnt/d:\n'
    { time git status --porcelain >/dev/null; } 2>&1 | sed 's/^/      /' || true
  fi

  if [ "${HUGIN_PROBE_MODELS:-0}" = "1" ]; then
    local models=("${HUGIN_MODELS[@]:-}")
    if [ "${#models[@]}" -eq 0 ]; then
      models=("cpa/claude-opus-4-6-thinking" "cpa/gpt-6.1-terra")
    fi
    local model
    for model in "${models[@]}"; do
      if claude -p --model "$model" "Reply with the single word OK." >/dev/null 2>&1; then
        printf 'PASS  model %s\n' "$model"
      else
        printf 'FAIL  model %s\n' "$model"
        failures=$((failures + 1))
      fi
    done
  fi

  echo
  if [ "$failures" -gt 0 ]; then
    echo "doctor: $failures check(s) failed"
    echo "If the project is not trusted yet, run './bin/hugin start' once, accept the trust dialog, then exit."
    exit 1
  fi
  echo "doctor: all checks passed"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  start) exec claude "$@" ;;
  dashboard) exec claude agents "$@" ;;
  console) exec node "$ROOT/bin/hugin-console.mjs" "$@" ;;
  ps) exec claude agents --json --all "$@" ;;
  attach) exec claude attach "$@" ;;
  logs) exec claude logs "$@" ;;
  stop) exec claude stop "$@" ;;
  new-run) new_run "$@" ;;
  memory) memory ;;
  remember) remember "$@" ;;
  recall) recall "$@" ;;
  status) status "$@" ;;
  doctor) doctor "$@" ;;
  help|-h|--help) usage ;;
  *)
    echo "unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
